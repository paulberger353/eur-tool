<Window x:Class="eur_tool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:eur_tool" mc:Ignorable="d" 
        Title="EÜR-Tool" WindowStyle="None"
        ResizeMode="NoResize" Height="600" Width="1100">
    <Grid Background="#CCCCC3">
        <Grid.RowDefinitions>
            <RowDefinition Height="0.1*"></RowDefinition>
            <RowDefinition Height="0.9*"></RowDefinition>
        </Grid.RowDefinitions>

        <!--Header-->
        <Grid Grid.Row="0" Background="Transparent"
              MouseLeftButtonDown="Grid_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.15*"/>
                <ColumnDefinition Width="0.66*"/>
                <ColumnDefinition Width="0.095*"/>
                <ColumnDefinition Width="0.095*"/>
            </Grid.ColumnDefinitions>

            <Viewbox Grid.Column="0" Margin="14" Stretch="Uniform">
                <Grid Width="48" Height="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="20"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderThickness="3" BorderBrush="#333333" CornerRadius="3" Background="Transparent" VerticalAlignment="Center" Height="20">
                        <Ellipse Width="4" Height="4" Fill="#333333" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Vertical">
                        <Rectangle Height="4" Fill="#007ACC" RadiusX="1.5" RadiusY="1.5" Margin="0,0,0,3.5"/>
                        <Rectangle Height="4" Fill="#333333" RadiusX="1.5" RadiusY="1.5" Margin="0,0,0,3.5"/>
                        <Rectangle Height="4" Fill="#27AE60" RadiusX="1.5" RadiusY="1.5"/>
                    </StackPanel>
                </Grid>
            </Viewbox>

            <TextBlock Grid.Column="0" Grid.ColumnSpan="4" TextDecorations="Underline"
                       TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"
                       Text="EÜR-Tool" FontSize="28" FontWeight="Normal"/>

            <Button Grid.Column="2" x:Name="btnMinimize" Click="btnMinimize_Click" Content="_" 
                    Background="#CCCCC3" Foreground="Black" VerticalContentAlignment="Top" 
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    FontWeight="SemiBold" FontSize="18" BorderThickness="1"
                    Width="75" Height="35">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">       
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Grid.Column="3" x:Name="btnClose" Click="btnClose_Click" Content="X" 
                    Background="#CCCCC3" Foreground="Black" VerticalContentAlignment="Top" 
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    FontWeight="Normal"  FontSize="18" BorderThickness="1"
                    Width="75" Height="35">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">       
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
        
        <!--Year Selection-->
        <Grid Grid.Row="1"></Grid>
        
        <!--Main Frame-->
        <Grid Grid.Row="1" Visibility="Hidden"></Grid>
    </Grid>
</Window>
