<Window x:Class="eur_tool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:eur_tool" mc:Ignorable="d" 
        Title="EÜR-Tool" Icon="Assets/eur-tool.ico" WindowStyle="None"
        ResizeMode="NoResize" Height="600" Width="1100">
    <Grid Background="#CCCCC3">
        <Grid.RowDefinitions>
            <RowDefinition Height="0.1*"></RowDefinition>
            <RowDefinition Height="0.9*"></RowDefinition>
        </Grid.RowDefinitions>

        <!--Header-->
        <Grid Grid.Row="0" Background="Transparent"
              MouseLeftButtonDown="Grid_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.15*"/>
                <ColumnDefinition Width="0.66*"/>
                <ColumnDefinition Width="0.095*"/>
                <ColumnDefinition Width="0.095*"/>
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0" Source="Assets/eur-tool.png" Width="36" Height="36"
                   Margin="14,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>

            <TextBlock Grid.Column="0" Grid.ColumnSpan="4" TextDecorations="Underline"
                       TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"
                       Text="EÜR-Tool" FontSize="28" FontWeight="Normal"/>

            <Button Grid.Column="2" x:Name="btnMinimize" Click="btnMinimize_Click" Content="_" 
                    Background="#CCCCC3" Foreground="Black" VerticalContentAlignment="Top" 
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    FontWeight="SemiBold" FontSize="18" BorderThickness="1"
                    Width="75" Height="35">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">       
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Grid.Column="3" x:Name="btnClose" Click="btnClose_Click" Content="X" 
                    Background="#CCCCC3" Foreground="Black" VerticalContentAlignment="Top" 
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    FontWeight="Normal"  FontSize="18" BorderThickness="1"
                    Width="75" Height="35">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">       
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
        
        <!--Year Selection-->
        <Grid Grid.Row="1" x:Name="gridYearSelection">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Jahr auswählen:" FontSize="20" Margin="0,0,0,10"
                               HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="6" Margin="0,10,0,0">
                        <ComboBox x:Name="cmbYear" Width="160" Height="32"
                                  Background="Transparent" BorderThickness="0"
                                  VerticalAlignment="Bottom" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                    </Border>
                </StackPanel>
                <Button Content="Start" Click="btnConfirmYear_Click" 
                        Margin="50,0,0,0" Height="40" Width="110"
                        VerticalAlignment="Center" FontSize="16" FontWeight="Light">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
        
        <!--Main Frame-->
        <Grid Grid.Row="1" Visibility="Hidden" x:Name="gridMainFrame">
            
        </Grid>
    </Grid>
</Window>
